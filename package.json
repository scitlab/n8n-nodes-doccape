{
  "name": "@scitlab/n8n-nodes-doccape",
  "version": "1.0.2",
  "description": "n8n node to redact (pseudonymize or anonymize) PII in text or files using the doccape API",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/scitlab/n8n-nodes-doccape",
  "author": {
    "name": "Scitlab",
    "email": "hi@scitlab.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scitlab/n8n-nodes-doccape.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DoccapeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Doccape/Doccape.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.40.3",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "release-it": "^20.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
